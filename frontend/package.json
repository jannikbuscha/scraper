{
  "name": "mdt-portfolio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MDT Portfolio web app (React, TypeScript, Vite, Mantine, TanStack).",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mantine/core": "^9.7.4",
    "@mantine/dates": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@mantine/notifications": "^9.7.4",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "dayjs": "^1.11.23",
    "diff": "^9.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
