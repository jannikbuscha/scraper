# MDT Portfolio configuration template. It contains no secrets.
#
#   cp .env.example .env      then adjust .env (gitignored, never commit it)
#
# docker compose reads .env twice:
#   1. for ${...} substitution in docker-compose.yml (HOST, PORT, APP_UID,
#      APP_GID), and
#   2. as env_file, i.e. as environment variables of the container.
# Inside the container the bind address (0.0.0.0:8080) and all paths are fixed
# by docker-compose.yml; the path settings below matter for local development only.
#
# Format: KEY=value, one per line. Quotes are optional. Avoid "$" in values
# (Compose would try to substitute it). Lines starting with "#" are comments;
# a commented-out setting uses the default shown.
#
# Schedule and backup settings arrive with Phase 4 (PLAN.md section 3.5).

# --- Network -----------------------------------------------------------------

# Where the app is reachable.
# Docker: host interface on which docker compose publishes the container port.
# Without Docker: default listen address of `mdt serve` (make dev always uses
# 127.0.0.1:8000). 127.0.0.1 makes the app reachable from the server itself only
# (README.md, "Access").
HOST=127.0.0.1

# Docker: host port on which the app is published. Without Docker: default
# listen port of `mdt serve`.
PORT=8080

# --- Research settings -------------------------------------------------------

# Contact address in the User-Agent of the collectors and manual fetches
# (docs/COLLECTORS.md section 4.4). Required for every collector run with
# network access: runs refuse to start while it is missing, not an e-mail
# address, or in a reserved example domain such as the placeholder below.
# Replace it with a project or functional address before running a collector.
# It never appears in the repository, exports or releases.
CONTACT_EMAIL=research-contact@example.org

# Optional project URL in the User-Agent ("+<PROJECT_URL>; mailto:..."), e.g. the
# paper's or the repository's public page. Default: empty (left out).
# PROJECT_URL=

# Maximum length of a comment in characters. Default: 10000
# MAX_COMMENT_CHARS=10000

# Seed key of the focal organisation (the ministry) in seed/projects.yaml; it
# anchors participations and the derived portfolio entry. It does not change
# when the organisation's slug is edited in the app.
# Default: ministry-of-digital-transformation
# FOCAL_ORG_SEED_KEY=ministry-of-digital-transformation

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL. Default: INFO
# LOG_LEVEL=INFO

# --- Data acquisition (docs/COLLECTORS.md section 3) -------------------------

# Collector settings: intervals, timeouts, hosts, licences, options. Relative
# paths resolve against the repository root. Fixed inside the container.
# Default: sources.yaml
# SOURCES_FILE=sources.yaml

# A running collector run without a heartbeat for this many seconds counts as
# interrupted (failed); a new run can start then. Default: 300
# RUN_STALE_AFTER_S=300

# Replay mode for development and E2E tests: collector runs answer from the
# fixtures in this directory instead of the network (no CONTACT_EMAIL needed).
# Default: empty (off). Always off inside the container. Example:
# COLLECTOR_REPLAY_DIR=backend/tests/fixtures/ministry_projects

# --- Paths (local development only; fixed inside the container) --------------
# Relative directory paths (DATA_DIR, CODEBOOK_DIR, SEED_DIR, FRONTEND_DIST)
# resolve against the repository root, wherever mdt is started.

# Runtime data: SQLite database and raw snapshots (data/raw), later backups.
# Default: data/ in the repository root (gitignored).
# DATA_DIR=data

# SQLAlchemy URL of the database. Default: SQLite file app.db in DATA_DIR.
# Example with an absolute path: sqlite:////srv/mdt/data/app.db
# DATABASE_URL=

# Controlled vocabularies (YAML). Default: codebook/
# CODEBOOK_DIR=codebook

# Seed data (19 + 1 projects and the focal organisation). Default: seed/
# SEED_DIR=seed

# Built frontend served by the backend. Default: frontend/dist
# FRONTEND_DIST=frontend/dist

# --- Docker image build ------------------------------------------------------

# User and group ID that run the app in the container and own the files in
# ./data on the host. Set them to your host user's `id -u` and `id -g` if those
# are not 1000, then rebuild (make up).
# APP_UID=1000
# APP_GID=1000
