# MDT Portfolio configuration template. It contains no secrets.
#
#   cp .env.example .env      then adjust .env (gitignored, never commit it)
#
# docker compose reads .env twice:
#   1. for ${...} substitution in docker-compose.yml (HOST, PORT, ALLOWED_HOSTS,
#      APP_UID, APP_GID), and
#   2. as env_file, i.e. as environment variables of the container.
# Inside the container the bind address (0.0.0.0:8080) and all paths are fixed
# by docker-compose.yml; the path settings below matter for local development only.
#
# Format: KEY=value, one per line. Quotes are optional. Avoid "$" in values
# (Compose would try to substitute it). Lines starting with "#" are comments;
# a commented-out setting uses the default shown.
#
# Collector, schedule, backup and upload settings arrive with Phases 2-4
# (PLAN.md section 3.5).

# --- Network -----------------------------------------------------------------

# Where the app is reachable.
# Docker: host interface on which docker compose publishes the container port.
# Without Docker: default listen address of `mdt serve` (make dev always uses
# 127.0.0.1:8000). Keep 127.0.0.1 unless the server is protected by a VPN or an
# authenticating reverse proxy: the app has no login (README.md, "Team access").
HOST=127.0.0.1

# Docker: host port on which the app is published. Without Docker: default
# listen port of `mdt serve`.
PORT=8080

# Host-header allowlist against DNS rebinding: comma-separated host names
# without port. Add the name the team uses to reach the app, e.g. behind a
# reverse proxy. Keep 127.0.0.1: the container health check uses it.
# "*" disables the check (unsafe).
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Research settings -------------------------------------------------------

# Contact address for the User-Agent of the collectors (from Phase 2 on; the
# collectors refuse to start without it). Replace the placeholder with a
# project or functional address before running any collector.
CONTACT_EMAIL=research-contact@example.org

# Names offered by the "Who are you?" author picker, comma-separated, e.g.
# TEAM_MEMBERS=First Name,Second Name. This is attribution, not
# authentication. Default: empty list (names can also be typed in freely).
# TEAM_MEMBERS=

# Maximum length of a comment in characters. Default: 10000
# MAX_COMMENT_CHARS=10000

# Slug of the focal organisation (the ministry) in the seed data; it anchors
# participations and the derived portfolio entry.
# Default: ministry-of-digital-transformation
# FOCAL_ORG_SLUG=ministry-of-digital-transformation

# Log level: DEBUG, INFO, WARNING or ERROR. Default: INFO
# LOG_LEVEL=INFO

# --- Paths (local development only; fixed inside the container) --------------

# Runtime data: SQLite database, later raw snapshots, backups, imports.
# Default: data/ in the repository root (gitignored).
# DATA_DIR=data

# SQLAlchemy URL of the database. Default: SQLite file app.db in DATA_DIR.
# Example with an absolute path: sqlite:////srv/mdt/data/app.db
# DATABASE_URL=

# Controlled vocabularies (YAML). Default: codebook/
# CODEBOOK_DIR=codebook

# Seed data (19 + 1 projects and the focal organisation). Default: seed/
# SEED_DIR=seed

# Built frontend served by the backend. Default: frontend/dist
# FRONTEND_DIST=frontend/dist

# --- Docker image build ------------------------------------------------------

# User and group ID that run the app in the container and own the files in
# ./data on the host. Set them to your host user's `id -u` and `id -g` if those
# are not 1000, then rebuild (make up).
# APP_UID=1000
# APP_GID=1000
